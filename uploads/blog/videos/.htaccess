# Deny execution of PHP files
<Files "*.php">
    Order Deny,Allow
    Deny from all
</Files>

# Deny execution of other script files
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Allow only video files
<FilesMatch "\.(mp4|webm|ogg|avi|mov)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>
